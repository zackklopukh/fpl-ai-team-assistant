# Copy to .env and fill in. Never commit .env.

# --- Postgres (Supabase) ---
# Ingestion uses the direct connection string (session pooler works too).
# Supabase: Project Settings -> Database -> Connection string -> URI
DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres

# --- Web app (web/.env.local) ---
# Anon key is public by design; the database is read-only reference data.
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Optimizer service ---
# Base URL the web app calls. Local dev: http://127.0.0.1:8000
OPTIMIZER_URL=http://127.0.0.1:8000

# --- FPL API ---
# Sent on every request. A contact address makes a block less likely.
FPL_USER_AGENT=fpl-ai-team-assistant/0.1 (+https://github.com/YOURNAME/fpl_ai_team_assistant)

# Current season, used as the first half of every natural key.
FPL_SEASON=2026-27
